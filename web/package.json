{
  "name": "recollect-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "engine": "wasm-pack build ../crates/recollect-wasm --target web --release --out-dir ../../web/src/engine/pkg --no-pack",
    "dev": "npm run engine && vite",
    "build": "npm run engine && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "fflate": "0.8.2",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
