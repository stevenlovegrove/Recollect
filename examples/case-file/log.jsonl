left_at","to":{"value":40}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9c4e1cd25b","component":"body","to":{"value":"The barman remembers calling time on Tom's tab at twenty to ten."}},{"op":"link","from":"01a1ba07-4fb6-7790-bb85-db9c4e1cd25b","to":"01a1ba07-4fb6-7790-bb85-db9b2219dbbe","kind":"alternative","value":{"weight":3.0}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9dc205f03e","component":"name","to":{"value":"At about 9:10, as Mrs Dale says"}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9dc205f03e","component":"left_at","to":{"value":10}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9dc205f03e","component":"body","to":{"value":"Mrs Dale was at the next table, and thinks he went just after nine. She'd had a few."}},{"op":"link","from":"01a1ba07-4fb6-7790-bb85-db9dc205f03e","to":"01a1ba07-4fb6-7790-bb85-db9b2219dbbe","kind":"alternative","value":{"weight":1.0}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9e410b07f2","component":"name","to":{"value":"How did Tom get to the house?"}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9e410b07f2","component":"decision","to":{"value":{}}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9e410b07f2","component":"uncertain","to":{"value":null}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9e410b07f2","component":"minutes","to":{"rule":{"rule":"expr@1","params":{"text":"pick(o in in.alternative: o.minutes)"}}}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9ff13d83ea","component":"name","to":{"value":"By bike, 25 minutes"}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9ff13d83ea","component":"minutes","to":{"value":25}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-db9ff13d83ea","component":"body","to":{"value":"Tom says his car was at the garage, so he cycled."}},{"op":"link","from":"01a1ba07-4fb6-7790-bb85-db9ff13d83ea","to":"01a1ba07-4fb6-7790-bb85-db9e410b07f2","kind":"alternative","value":{"weight":2.0}},{"op":"set","id":"01a1ba07-4fb6-7790-bb85-dba0e0ebaf96","component":"name","to":{"value":"By car, 10 minutes"}},{"op":"set","id