{"record":"event","seq":0,"at":1793572476268,"author":"sample","why":"Each region is a choice and each border a constraint. There are 18 colourings. Pin a region and see what that forces.","ops":[{"op":"set","id":"01a19940-156c-7599-b1b6-53764d67c8a5","component":"name","to":{"value":"A colouring"}},{"op":"set","id":"01a19940-156c-7599-b1b6-53764d67c8a5","component":"value","to":{"rule":{"rule":"expr@1","params":{"text":"all(constraint)"}}}},{"op":"set","id":"01a19940-156c-7599-b1b6-53764d67c8a5","component":"requires","to":{"value":null}},{"op":"set","id":"01a19940-156c-7599-b1b6-5377f21db126","component":"name","to":{"value":"Western Australia"}},{"op":"set","id":"01a19940-156c-7599-b1b6-5377f21db126","component":"domain","to":{"value":["red","green","blue"]}},{"op":"set","id":"01a19940-156c-7599-b1b6-5378e5c4ea09","component":"name","to":{"value":"Northern Territory"}},{"op":"set","id":"01a19940-156c-7599-b1b6-5378e5c4ea09","component":"domain","to":{"value":["red","green","blue"]}},{"op":"set","id":"01a19940-156c-7599-b1b6-537903b2df28","component":"name","to":{"value":"South Australia"}},{"op":"set","id":"01a19940-156c-7599-b1b6-537903b2df28","component":"domain","to":{"value":["red","green","blue"]}},{"op":"set","id":"01a19940-156c-7599-b1b6-537aef6645a4","component":"name","to":{"value":"Queensland"}},{"op":"set","id":"01a19940-156c-7599-b1b6-537aef6645a4","component":"domain","to":{"value":["red","green","blue"]}},{"op":"set","id":"01a19940-156c-7599-b1b6-537b9003ee96","component":"name","to":{"value":"New South Wales"}},{"op":"set","id":"01a19940-156c-7599-b1b6-537b9003ee96","component":"domain","to":{"value":["red","green","blue"]}},{"op":"set","id":"01a19940-156c-7599-b1b6-537cfbb97f8b","component":"name","to":{"value":"Victoria"}},{"op":"set","id":"01a19940-156c-7599-b1b6-537cfbb97f8b","component":"domain","to":{"value":["red","green","blue"]}},{"op":"set","id":"01a19940-156c-7599-b1b6-537dbe80fed3","component":"name","to":{"value":"Tasmania"}},{"op":"set","id":"01a19940-156c-7599-b1b6-537dbe80fed3","component":"domain","to":{"value":["red","green","blue"]}},{"op":"set","id":"01a19940-156c-7599-b1b6-537ea41c1e1b","component":"name","to":{"value":"Map of Australia"}},{"op":"set","id":"01a19940-156c-7599-b1b6-537ea41c1e1b","component":"drawing","to":{"value":"// Australia as a map. A region takes its colour once it's pinned or there's only one left, and until\n// then it shows the colours it could still be, which can be clicked to pin one.\n\nconst shapes: Record<string, { outline: string; label: [number, number] }> = {\n  \"Western Australia\": { outline: \"20,120 150,50 150,290 60,300 20,240\", label: [85, 180] },\n  \"Northern Territory\": { outline: \"150,50 260,40 260,190 150,190\", label: [205, 110] },\n  \"South Australia\": { outline: \"150,190 300,190 300,310 240,290 150,290\", label: [225, 240] },\n  Queensland: { outline: \"260,40 300,20 340,110 420,190 300,190 260,190\", label: [325, 145] },\n  \"New South Wales\": { outline: \"300,190 420,190 400,280 300,270\", label: [355, 235] },\n  Victoria: { outline: \"300,270 400,280 372,340 300,325\", label: [345, 293] },\n  Tasmania: { outline: \"305,352 395,352 378,412 322,412\", label: [350, 372] },\n};\n\nconst paints: Record<string, string> = { red: \"#d9534f\", green: \"#4caf6d\", blue: \"#4a7fd6\" };\n\nexport function draw(world: World): string {\n  const regions = world.choices.map((c) => {\n    const shape = shapes[c.name];\n    if (!shape) return \"\";\n    const left = c.options.filter((o) => o.possible);\n    const settled = c.options.find((o) => o.picked) ?? (left.length === 1 ? left[0] : undefined);\n    const [x, y] = shape.label;\n    const fill = settled ? paints[settled.name] : \"var(--panel)\";\n    const ink = settled ? \"#ffffff\" : \"var(--text)\";\n    const pick = settled ? `data-pin-choice=\"${c.id}\" data-pin-option=\"${settled.id}\" style=\"cursor:pointer\"` : \"\";\n    const dots = settled\n      ? \"\"\n      : left\n          .map((o, i) => {\n            const dx = x + (i - (left.length - 1) / 2) * 22;\n            return `<circle data-pin-choice=\"${c.id}\" data-pin-option=\"${o.id}\" cx=\"${dx}\" cy=\"${y + 16}\" r=\"8\" fill=\"${paints[o.name]}\" style=\"cursor:pointer\" />`;\n          })\n          .join(\"\");\n    const none = left.length === 0 ? `<text x=\"${x}\" y=\"${y + 20}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--muted)\">no colour left</text>` : \"\";\n    return `<polygon ${pick} points=\"${shape.outline}\" fill=\"${fill}\" stroke=\"var(--text)\" stroke-width=\"1.5\" />\n      <text x=\"${x}\" y=\"${y}\" text-anchor=\"middle\" font-size=\"11\" fill=\"${ink}\" style=\"pointer-events:none\">${c.name}</text>${dots}${none}`;\n  });\n  return `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 440 420\" width=\"440\">${regions.join(\"\")}</svg>`;\n}\n"}},{"op":"set","id":"01a19940-156c-7599-b1b6-537fbcc220a3","component":"name","to":{"value":"Western Australia ≠ Northern Territory"}},{"op":"set","id":"01a19940-156c-7599-b1b6-537fbcc220a3","component":"value","to":{"rule":{"rule":"expr@1","params":{"text":"a != b"}}}},{"op":"link","from":"01a19940-156c-7599-b1b6-537fbcc220a3","to":"01a19940-156c-7599-b1b6-5377f21db126","kind":"label","value":"a"},{"op":"link","from":"01a19940-156c-7599-b1b6-537fbcc220a3","to":"01a19940-156c-7599-b1b6-5378e5c4ea09","kind":"label","value":"b"},{"op":"link","from":"01a19940-156c-7599-b1b6-53764d67c8a5","to":"01a19940-156c-7599-b1b6-537fbcc220a3","kind":"label","value":"constraint"},{"op":"set","id":"01a19940-156c-7599-b1b6-538095e72921","component":"name","to":{"value":"Western Australia ≠ South Australia"}},{"op":"set","id":"01a19940-156c-7599-b1b6-538095e72921","component":"value","to":{"rule":{"rule":"expr@1","params":{"text":"a != b"}}}},{"op":"link","from":"01a19940-156c-7599-b1b6-538095e72921","to":"01a19940-156c-7599-b1b6-5377f21db126","kind":"label","value":"a"},{"op":"link","from":"01a19940-156c-7599-b1b6-538095e72921","to":"0