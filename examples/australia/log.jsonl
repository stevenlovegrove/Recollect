{"record":"event","seq":0,"at":1794221860928,"author":"sample","why":"Each region is a choice and each border a constraint. There are 18 colourings. Pin a region and see what that forces.","ops":[{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de4996bf1318"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4996bf1318","cell":"name","value":"A colouring"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de4996bf1318","component":"value"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4996bf1318","cell":"value","formula":"all(constraint)"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de4996bf1318","component":"requires"},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de4ac90ea2ee"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4ac90ea2ee","cell":"name","value":"Western Australia"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de4ac90ea2ee","component":"options"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4ac90ea2ee","cell":"options","value":["red","green","blue"]},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de4bc5cc26c7"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4bc5cc26c7","cell":"name","value":"Northern Territory"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de4bc5cc26c7","component":"options"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4bc5cc26c7","cell":"options","value":["red","green","blue"]},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de4ce9a804cd"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4ce9a804cd","cell":"name","value":"South Australia"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de4ce9a804cd","component":"options"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4ce9a804cd","cell":"options","value":["red","green","blue"]},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de4d5a45f4d6"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4d5a45f4d6","cell":"name","value":"Queensland"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de4d5a45f4d6","component":"options"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4d5a45f4d6","cell":"options","value":["red","green","blue"]},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de4e92782b4a"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4e92782b4a","cell":"name","value":"New South Wales"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de4e92782b4a","component":"options"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4e92782b4a","cell":"options","value":["red","green","blue"]},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de4f1df3c14e"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4f1df3c14e","cell":"name","value":"Victoria"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de4f1df3c14e","component":"options"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de4f1df3c14e","cell":"options","value":["red","green","blue"]},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de50b1a28a52"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de50b1a28a52","cell":"name","value":"Tasmania"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de50b1a28a52","component":"options"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de50b1a28a52","cell":"options","value":["red","green","blue"]},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de51961fdc31"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de51961fdc31","cell":"name","value":"Map of Australia"},{"op":"add","id":"01a1bff4-e83b-75af-8aba-de51961fdc31","component":"drawing"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de51961fdc31","cell":"drawing","value":"// Australia as a map. A region takes its colour once it's pinned or there's only one left, and until\n// then it shows the colours it could still be, which can be clicked to pin one.\n\nconst shapes: Record<string, { outline: string; label: [number, number] }> = {\n  \"Western Australia\": { outline: \"20,120 150,50 150,290 60,300 20,240\", label: [85, 180] },\n  \"Northern Territory\": { outline: \"150,50 260,40 260,190 150,190\", label: [205, 110] },\n  \"South Australia\": { outline: \"150,190 300,190 300,310 240,290 150,290\", label: [225, 240] },\n  Queensland: { outline: \"260,40 300,20 340,110 420,190 300,190 260,190\", label: [325, 145] },\n  \"New South Wales\": { outline: \"300,190 420,190 400,280 300,270\", label: [355, 235] },\n  Victoria: { outline: \"300,270 400,280 372,340 300,325\", label: [345, 293] },\n  Tasmania: { outline: \"305,352 395,352 378,412 322,412\", label: [350, 372] },\n};\n\nconst paints: Record<string, string> = { red: \"#d9534f\", green: \"#4caf6d\", blue: \"#4a7fd6\" };\n\nexport function draw(world: World): string {\n  const regions = world.choices.map((c) => {\n    const shape = shapes[c.name];\n    if (!shape) return \"\";\n    const left = c.options.filter((o) => o.possible);\n    const settled = c.options.find((o) => o.picked) ?? (left.length === 1 ? left[0] : undefined);\n    const [x, y] = shape.label;\n    const fill = settled ? paints[settled.name] : \"var(--panel)\";\n    const ink = settled ? \"#ffffff\" : \"var(--text)\";\n    const pick = settled ? `data-pin-choice=\"${c.id}\" data-pin-option=\"${settled.id}\" style=\"cursor:pointer\"` : \"\";\n    const dots = settled\n      ? \"\"\n      : left\n          .map((o, i) => {\n            const dx = x + (i - (left.length - 1) / 2) * 22;\n            return `<circle data-pin-choice=\"${c.id}\" data-pin-option=\"${o.id}\" cx=\"${dx}\" cy=\"${y + 16}\" r=\"8\" fill=\"${paints[o.name]}\" style=\"cursor:pointer\" />`;\n          })\n          .join(\"\");\n    const none = left.length === 0 ? `<text x=\"${x}\" y=\"${y + 20}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--muted)\">no colour left</text>` : \"\";\n    return `<polygon ${pick} points=\"${shape.outline}\" fill=\"${fill}\" stroke=\"var(--text)\" stroke-width=\"1.5\" />\n      <text x=\"${x}\" y=\"${y}\" text-anchor=\"middle\" font-size=\"11\" fill=\"${ink}\" style=\"pointer-events:none\">${c.name}</text>${dots}${none}`;\n  });\n  return `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 440 420\" width=\"440\">${regions.join(\"\")}</svg>`;\n}\n"},{"op":"spawn","id":"01a1bff4-e83b-75af-8aba-de52f4331479"},{"op":"set","id":"01a1bff4-e83b-75af-8aba-de52f4331479","cell":"name","value":"Western Australi