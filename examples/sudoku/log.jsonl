{"record":"event","seq":0,"at":1794221861083,"author":"sample","why":"A table of sixteen cells, each choosing a number, and a clue for each row, column and box: distinct(Cell[A1], Cell[A2], …). There are 288 grids.","ops":[{"op":"spawn","id":"01a1bff4-e8d4-779b-b23b-3756acd81813"},{"op":"set","id":"01a1bff4-e8d4-779b-b23b-3756acd81813","cell":"name","value":"A grid"},{"op":"add","id":"01a1bff4-e8d4-779b-b23b-3756acd81813","component":"value"},{"op":"set","id":"01a1bff4-e8d4-779b-b23b-3756acd81813","cell":"value","formula":"all(constraint)"},{"op":"add","id":"01a1bff4-e8d4-779b-b23b-3756acd81813","component":"requires"},{"op":"spawn","id":"01a1bff4-e8d4-779b-b23b-375701665806"},{"op":"set","id":"01a1bff4-e8d4-779b-b23b-375701665806","cell":"name","value":"Board with its boxes"},{"op":"add","id":"01a1bff4-e8d4-779b-b23b-375701665806","component":"drawing"},{"op":"set","id":"01a1bff4-e8d4-779b-b23b-375701665806","cell":"drawing","value":"// A sudoku board. The boxes are this puzzle's own business, so they're drawn here, and not worked\n// out by the app. Change `box` for a different size of box.\n\nconst box = { rows: 2, cols: 2 };\nconst size = 88;\n\nexport function draw(world: World): string {\n  const at = new Map(world.nodes.map((n) => [n.id, n.cells.at?.value as { row: number; col: number } | undefined]));\n  const placed = world.choices.filter((c) => at.get(c.id));\n  const rows = Math.max(...placed.map((c) => at.get(c.id)!.row)) + 1;\n  const cols = Math.max(...placed.map((c) => at.get(c.id)!.col)) + 1;\n\n  const cells = placed.map((c) => {\n    const { row, col } = at.get(c.id)!;\n    const [x, y] = [col * size, row * size];\n    const left = c.options.filter((o) => o.possible);\n    const pinned = c.options.find((o) => o.picked);\n    const only = pinned ?? (left.length === 1 ? left[0] : undefined);\n    if (only) {\n      const colour = pinned ? \"var(--accent)\" : \"var(--text)\";\n      return `<text data-pin-choice=\"${c.id}\" data-pin-option=\"${only.id}\" x=\"${x + size / 2}\" y=\"${y + size / 2 + 12}\" text-anchor=\"middle\" font-size=\"36\" fill=\"${colour}\" style=\"cursor:pointer\">${only.name}</text>`;\n    }\n    // Each option keeps its place, so what's been ruled out leaves a gap.\n    const across = Math.ceil(Math.sqrt(c.options.length));\n    return c.options\n      .filter((o) => o.possible)\n      .map((o) => {\n        const i = c.options.indexOf(o);\n        const [ox, oy] = [x + ((i % across) + 0.5) * (size / across), y + (Math.floor(i / across) + 0.5) * (size / across)];\n        return `<text data-pin-choice=\"${c.id}\" data-pin-option=\"${o.id}\" x=\"${ox}\" y=\"${oy + 5}\" text-anchor=\"middle\" font-size=\"15\" fill=\"var(--muted)\" style=\"cursor:pointer\">${o.name}</text>`;\n      })\n      .join(\"\");\n  });\n\n  const lines: string[] = [];\n  for (let r = 0; r <= rows; r++) lines.push(line(0, r * size, cols * size, r * size, r % box.rows === 0));\n  for (let c = 0; c <= cols; c++) lines.push(line(c * size, 0, c * size, rows * size, c % box.cols === 0));\n\n  return `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-2 -2 ${cols * size + 4} ${rows * size + 4}\" width=\"${cols * size + 4}\">${lines.join(\"\")}${cells.join(\"\")}</svg>`;\n}\n\nfunction line(x1: number, y1: number, x2: number, y2: number, heavy: boolean): string {\n  return `<line x1=\"${x1}\" y1=\"${y1}\" x2=\"${x2}\" y2=\"${y2}\" stroke=\"${heavy ? \"var(--text)\" : \"var(--border)\"}\" stroke-width=\"${heavy ? 3 : 1}\" />`;\n}\n"},{"op":"spawn","id":"01a1bff4-e8d4-779b-b23b-37583bf19aa1"},{"op":"set","id":"01a1bff4-e8d4-779b-b23b-37583bf19aa1","cell":"name","value":"Cell"},{"op":"add","id":"01a1bff4-e8d4-779b-b23b-37583bf19aa1","component":"options"},{"op":"set","id":"01a1bff4-e8d4-779b-b23b-37583bf19aa1","cell":"options","value":["1","2","3","4"]},{"op":"spawn","id":"01a1bff4-e8d4-779b-b23b-37597b6bfed2"},{"op":"set","id":"01a1bff4-e8d4-779b-b23b-37597b6bfed2","cell":"name","value":"Cell[A1]"},{"op":"spawn","id":"01a1bf